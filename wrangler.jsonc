{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "alienchord",
    "main": "worker.ts",
    "compatibility_date": "2026-09-21",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "vars": {
        "AUTH_URL": "https://alienchord.alienchord-official.workers.dev"
    },
    "observability": {
        "enabled": true
    }
}